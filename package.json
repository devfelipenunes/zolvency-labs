  "private": true,
  "type": "module",
  "scripts": {
    "export:models": "node scripts/export-models.mjs",
    "predev": "npm run facility:stage",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run facility:stage",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "test:browser": "node scripts/browser-check.mjs",
